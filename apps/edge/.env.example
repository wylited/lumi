# The rig's settings. Copy it and run with it:
#
#     uv run --env-file .env heli-rig
#
# On a machine that has never run the rig, start with:
#
#     uv run heli-rig --doctor
#
# It reports what this machine has and what each missing piece needs.
# Every value below is also the rig's default, so an empty file is a working
# bench. Nothing here is a secret: the desk token is minted by the server and
# kept in ~/.heli/rig.json — HELI_DESK_TOKEN is only for handing one to a rig by
# hand.

# The server. The desk socket is derived from it: http -> ws, https -> wss, on
# /ws/desk.
HELI_API_URL=http://localhost:3001

# The tracking console that already holds the UVC camera on this Mac.
HELI_CONSOLE_URL=http://127.0.0.1:8643

# auto    the console when it answers with a fresh frame, else the device
# console only the console's frame (the UVC device stays with tracking.visiond).
#         Its picture has the tracker's box, crosshair and text drawn on it, and
#         the rig uploads what it is handed — so this is not what lumi wants.
# opencv  only the device directly: clean footage, and the source lumi uses
HELI_CAMERA_SOURCE=auto

# The AVFoundation index, for HELI_CAMERA_SOURCE=opencv. On this Mac `[0] USB
# Camera` is index 0 and `[1] FaceTime HD` is index 1; the console holds 0.
HELI_CAMERA_INDEX=0

# Frames per second while a session is live. A 409 (no open session) slows the
# rig to a fifth of this rather than stopping it.
HELI_FPS=2

# The server refuses anything over 1600 px on the long edge or 2 MB, so the rig
# downscales and encodes here, where the pixels are.
HELI_MAX_EDGE_PX=1600
HELI_JPEG_QUALITY=80

# The name the desk registers under.
HELI_DESK_NAME=Desk 1

# auto     the console's arm when it answers, else the serial bridge
# console  the console's arm only
# serial   the tracking bridge only — never while the console is running
# none     no arm; the server sends no aim actions
HELI_ARM_DRIVER=auto

# The serial fallback starts a bridge out of another project — the one that owns
# the bus, `tracking/bridge.py` and a `lerobot` install. It is not part of this
# repo, so on any machine but the bench it has to be pointed at:
#   HELI_BRIDGE_DIR=/path/to/tracking
#   HELI_BRIDGE_PYTHON=/path/to/tracking/.venv/bin/python   (default: the dir's own .venv)
# `heli-rig --doctor` says which of the two is wrong.
HELI_BRIDGE_DIR=~/Repos/tracking

# Play the spoken line on this Mac's speakers. false acknowledges the line
# `no_speaker` instead of playing it.
HELI_SPEAKER=true

# off   the observer's rig: it aims when it is told to, and never on its own
# auto  follow the person at the desk: the pose model, the control law, the arm
HELI_TRACKING=off

# The pose model, run by cv2.dnn (no torch, no second venv). Relative paths are
# resolved against apps/edge, so it is found from any working directory.
HELI_MODEL=models/yolo11n-pose.onnx

# The tracker's own cadence — detection is ~25 fps on CPU, and 10 is enough to
# keep a person centred. Not the upload cadence, which is HELI_FPS.
HELI_TRACK_FPS=10

# The share of the frame the chest may sit off the aim point before the arm
# moves. Without a deadband a person sitting still is chased by keypoint jitter.
HELI_TRACK_DEADBAND=0.08

# debug | info | warning | error | critical
HELI_LOG_LEVEL=info

# Where the rig keeps its own state: the desk id and token, and the arm's
# calibration rectangle, in one shared file.
HELI_DIR=~/.heli

# The desk rectangle `--calibrate` records, in millimetres: x,y,w,h from the
# desk's own origin. Leave it out and pass `--rect` on the run instead.
# HELI_DESK_RECT=0,0,300,220

# The bench bootstrap, for a rig that has no desk token yet. The dev-login of
# this server takes no address and no body — it returns the seeded single user —
# so the rig sends neither.
# HELI_DESK_TOKEN=
