# Helicopter server environment.
# Copy to apps/server/.env — only DATABASE_URL and JWT_SECRET are required.
# Everything else has a safe default, and the model/speech paths boot keyless.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DEMO_MODE=false

# --- database (required) ---------------------------------------------------
# Matches docker-compose.yml: user/password/db all "heli" on localhost:5432.
DATABASE_URL=postgresql://heli:heli@localhost:5432/heli?schema=public

# --- auth (required) -------------------------------------------------------
# Any non-empty string in dev. Rotate per environment.
JWT_SECRET=dev-only-change-me

# --- vision / assessment ---------------------------------------------------
# deepseek | gemini | local. "local" returns canned assessments with no key.
VISION_PROVIDER=local
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_PROJECT=
GEMINI_LOCATION=asia-southeast1

# --- speech out ------------------------------------------------------------
# local | elevenlabs. "local" speaks offline with no key.
SPEECH_PROVIDER=local
ELEVENLABS_API_KEY=

# --- media / object store (MinIO in compose) -------------------------------
MEDIA_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=heli
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml.
S3_ACCESS_KEY_ID=heli
S3_SECRET_ACCESS_KEY=heli-minio-dev
S3_FORCE_PATH_STYLE=true
