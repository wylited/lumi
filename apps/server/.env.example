# Helicopter server environment.
# Copy to apps/server/.env. DATABASE_URL and JWT_SECRET boot the server; the
# loop also needs DEEPSEEK_API_KEY and both ElevenLabs values, or it does not
# start and the log names the missing key.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- database (required) ---------------------------------------------------
# Matches docker-compose.yml: user/password/db all "heli" on localhost:5432.
DATABASE_URL=postgresql://heli:heli@localhost:5432/heli?schema=public

# --- auth (required) -------------------------------------------------------
# Any non-empty string in dev. Rotate per environment.
JWT_SECRET=dev-only-change-me

# --- vision / assessment ---------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_PROJECT=
GEMINI_LOCATION=asia-southeast1

# --- speech out ------------------------------------------------------------
# Both values. Default voice: Matilda (XrExE9yKIg1WjnnlVkGX);
# alternates: Alice (Xb7hH8MSUJpSbSDYk0k2), Sarah (EXAVITQu4vr4xnSDxMaL).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- media / object store (MinIO in compose) -------------------------------
MEDIA_ENABLED=true
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=heli
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml.
S3_ACCESS_KEY_ID=heli
S3_SECRET_ACCESS_KEY=heli-minio-dev
S3_FORCE_PATH_STYLE=true
